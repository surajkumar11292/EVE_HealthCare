# Application Settings
APP_NAME="EVE Healthcare API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="change_this_to_a_secure_random_32_character_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16)
# Async URL used by FastAPI application via asyncpg
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/eve_healthcare"
# Sync URL used by Alembic migrations via psycopg2
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eve_healthcare"

# Redis Configuration (Cache & Rate Limiting)
REDIS_URL="redis://localhost:6379/0"

# Celery Configuration (Background Worker)
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Rate Limiting
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_PAYMENT="20/minute"
RATE_LIMIT_WEBHOOK="100/minute"

# Webhook Security
WEBHOOK_SECRET="super_secret_webhook_signature_key"
